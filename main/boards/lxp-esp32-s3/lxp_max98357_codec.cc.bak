#include "lxp_max98357_codec.h"

#include <esp_log.h>
#include <cmath>
#include <climits>
#include <cstring>
#include <vector>

#define TAG "LxpMax98357"

LxpMax98357Codec::LxpMax98357Codec(int input_sample_rate, int output_sample_rate,
                                   gpio_num_t spk_bclk, gpio_num_t spk_ws, gpio_num_t spk_dout,
                                   gpio_num_t mic_sck, gpio_num_t mic_ws, gpio_num_t mic_din) {
    duplex_ = false;
    input_sample_rate_ = input_sample_rate;
    output_sample_rate_ = output_sample_rate;
    output_volume_ = 55;  // 小喇叭+MAX98357 默认 55，避免破音

    i2s_chan_config_t chan_cfg = {
        .id = XIAOZHI_I2S_PORT(0),
        .role = I2S_ROLE_MASTER,
        .dma_desc_num = AUDIO_CODEC_DMA_DESC_NUM,
        .dma_frame_num = AUDIO_CODEC_DMA_FRAME_NUM,
        .auto_clear_after_cb = true,
        .auto_clear_before_cb = false,
        .intr_priority = 0,
    };
    ESP_ERROR_CHECK(i2s_new_channel(&chan_cfg, &tx_handle_, nullptr));

    // 16-bit Philips I2S：多数 MAX98357 小板比 32-bit 更清晰
    i2s_std_config_t tx_cfg = {
        .clk_cfg =
            {
                .sample_rate_hz = (uint32_t)output_sample_rate_,
                .clk_src = I2S_CLK_SRC_DEFAULT,
                .mclk_multiple = I2S_MCLK_MULTIPLE_256,
#ifdef I2S_HW_VERSION_2
                .ext_clk_freq_hz = 0,
#endif
            },
        .slot_cfg =
            {
                .data_bit_width = I2S_DATA_BIT_WIDTH_16BIT,
                .slot_bit_width = I2S_SLOT_BIT_WIDTH_16BIT,
                .slot_mode = I2S_SLOT_MODE_STEREO,
                .slot_mask = I2S_STD_SLOT_BOTH,
                .ws_width = I2S_DATA_BIT_WIDTH_16BIT,
                .ws_pol = false,
                .bit_shift = true,
#ifdef I2S_HW_VERSION_2
                .left_align = false,
                .big_endian = false,
                .bit_order_lsb = false,
#endif
            },
        .gpio_cfg =
            {
                .mclk = I2S_GPIO_UNUSED,
                .bclk = spk_bclk,
                .ws = spk_ws,
                .dout = spk_dout,
                .din = I2S_GPIO_UNUSED,
                .invert_flags = {.mclk_inv = false, .bclk_inv = false, .ws_inv = false},
            },
    };
    ESP_ERROR_CHECK(i2s_channel_init_std_mode(tx_handle_, &tx_cfg));

    chan_cfg.id = XIAOZHI_I2S_PORT(1);
    ESP_ERROR_CHECK(i2s_new_channel(&chan_cfg, nullptr, &rx_handle_));
    i2s_std_config_t rx_cfg = tx_cfg;
    rx_cfg.clk_cfg.sample_rate_hz = (uint32_t)input_sample_rate_;
    rx_cfg.slot_cfg.data_bit_width = I2S_DATA_BIT_WIDTH_32BIT;
    rx_cfg.slot_cfg.slot_bit_width = I2S_SLOT_BIT_WIDTH_AUTO;
    rx_cfg.slot_cfg.slot_mode = I2S_SLOT_MODE_MONO;
    rx_cfg.slot_cfg.slot_mask = I2S_STD_SLOT_LEFT;
    rx_cfg.slot_cfg.ws_width = I2S_DATA_BIT_WIDTH_32BIT;
    rx_cfg.gpio_cfg.bclk = mic_sck;
    rx_cfg.gpio_cfg.ws = mic_ws;
    rx_cfg.gpio_cfg.dout = I2S_GPIO_UNUSED;
    rx_cfg.gpio_cfg.din = mic_din;
    ESP_ERROR_CHECK(i2s_channel_init_std_mode(rx_handle_, &rx_cfg));

    ESP_LOGI(TAG, "TX 16-bit %dHz + treble boost; RX 32-bit %dHz", output_sample_rate_,
             input_sample_rate_);
}

LxpMax98357Codec::~LxpMax98357Codec() {
    if (rx_handle_) {
        i2s_channel_disable(rx_handle_);
    }
    if (tx_handle_) {
        i2s_channel_disable(tx_handle_);
    }
}

void LxpMax98357Codec::Start() {
    AudioCodec::Start();
    // 测试音曾把 NVS 音量写成 100，强制压到安全范围防破音
    if (output_volume_ > 70) {
        ESP_LOGW(TAG, "Clamp output volume %d → 55 (anti-clip)", output_volume_);
        SetOutputVolume(55);
    }
}

int LxpMax98357Codec::Write(const int16_t* data, int samples) {
    std::lock_guard<std::mutex> lock(data_if_mutex_);
    std::vector<int16_t> stereo(static_cast<size_t>(samples) * 2);

    // 线性音量（不用平方），并软限幅，避免破音
    const float vol = static_cast<float>(output_volume_) / 100.0f;
    constexpr float kLimit = 22000.0f;

    for (int i = 0; i < samples; ++i) {
        float y = static_cast<float>(data[i]) * vol;
        if (y > kLimit) y = kLimit;
        if (y < -kLimit) y = -kLimit;
        int16_t s = static_cast<int16_t>(y);
        stereo[static_cast<size_t>(i) * 2] = s;
        stereo[static_cast<size_t>(i) * 2 + 1] = s;
    }

    size_t bytes_written = 0;
    ESP_ERROR_CHECK(i2s_channel_write(tx_handle_, stereo.data(), stereo.size() * sizeof(int16_t),
                                      &bytes_written, portMAX_DELAY));
    return static_cast<int>(bytes_written / (sizeof(int16_t) * 2));
}

int LxpMax98357Codec::Read(int16_t* dest, int samples) {
    size_t bytes_read = 0;
    std::vector<int32_t> bit32(static_cast<size_t>(samples));
    if (i2s_channel_read(rx_handle_, bit32.data(), samples * sizeof(int32_t), &bytes_read, 200) !=
        ESP_OK) {
        return 0;
    }
    samples = static_cast<int>(bytes_read / sizeof(int32_t));
    for (int i = 0; i < samples; ++i) {
        int32_t value = bit32[static_cast<size_t>(i)] >> 12;
        dest[i] = (value > INT16_MAX) ? INT16_MAX : (value < -INT16_MAX) ? -INT16_MAX : (int16_t)value;
    }
    return samples;
}

void LxpMax98357Codec::EnableInput(bool enable) {
    std::lock_guard<std::mutex> lock(data_if_mutex_);
    if (enable == input_enabled_) return;
    if (enable) {
        ESP_ERROR_CHECK(i2s_channel_enable(rx_handle_));
    } else {
        ESP_ERROR_CHECK(i2s_channel_disable(rx_handle_));
    }
    AudioCodec::EnableInput(enable);
}

void LxpMax98357Codec::EnableOutput(bool enable) {
    std::lock_guard<std::mutex> lock(data_if_mutex_);
    if (enable == output_enabled_) return;
    if (enable) {
        ESP_ERROR_CHECK(i2s_channel_enable(tx_handle_));
    } else {
        ESP_ERROR_CHECK(i2s_channel_disable(tx_handle_));
    }
    AudioCodec::EnableOutput(enable);
}
